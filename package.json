{
  "name": "designed",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "author": "ktjn",
  "homepage": "https://ktjn.github.io/designed/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ktjn/designed.git"
  },
  "bugs": {
    "url": "https://github.com/ktjn/designed/issues"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "ci": "pnpm install --frozen-lockfile && pnpm run lint && pnpm --filter \"./packages/*\" run build && pnpm run typecheck && pnpm --filter @ktjn/storybook exec playwright install chromium && pnpm run test && pnpm run check:packages && pnpm run check:size && pnpm run check:tarballs",
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r --if-present run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "changeset": "changeset",
    "release": "changeset publish",
    "check:packages": "pnpm -r --if-present run check:package",
    "check:tarballs": "tsx scripts/check-tarballs.ts",
    "check:size": "pnpm -r --if-present run size"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.6.9",
    "@changesets/cli": "3.0.3",
    "@types/node": "26.6.7",
    "publint": "0.3.25",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
