{
  "color": {
    "background": {
      "default": {
        "$type": "color",
        "$value": "{color.neutral.0}"
      },
      "subtle": {
        "$type": "color",
        "$value": "{color.neutral.100}"
      },
      "muted": {
        "$type": "color",
        "$value": "{color.neutral.200}"
      },
      "selected": {
        "$type": "color",
        "$value": "{color.blue.100}"
      }
    },
    "foreground": {
      "default": {
        "$type": "color",
        "$value": "{color.neutral.900}"
      },
      "muted": {
        "$type": "color",
        "$value": "{color.neutral.700}"
      },
      "inverse": {
        "$type": "color",
        "$value": "{color.neutral.0}"
      }
    },
    "border": {
      "default": {
        "$type": "color",
        "$value": "{color.neutral.200}"
      },
      "focus": {
        "$type": "color",
        "$value": "{color.blue.500}"
      },
      "control": {
        "$type": "color",
        "$value": "{color.neutral.500}"
      },
      "strong": {
        "$type": "color",
        "$value": "{color.neutral.700}"
      }
    },
    "action": {
      "primary": {
        "default": {
          "$type": "color",
          "$value": "{color.blue.600}"
        },
        "hover": {
          "$type": "color",
          "$value": "{color.blue.700}"
        },
        "active": {
          "$type": "color",
          "$value": "{color.blue.800}"
        },
        "foreground": {
          "$type": "color",
          "$value": "{color.neutral.0}"
        }
      },
      "danger": {
        "default": {
          "$type": "color",
          "$value": "{color.red.600}"
        },
        "hover": {
          "$type": "color",
          "$value": "{color.red.700}"
        },
        "active": {
          "$type": "color",
          "$value": "{color.red.800}"
        },
        "foreground": {
          "$type": "color",
          "$value": "{color.neutral.0}"
        }
      }
    },
    "status": {
      "info": {
        "background": {
          "$type": "color",
          "$value": "{color.blue.50}"
        },
        "foreground": {
          "$type": "color",
          "$value": "{color.blue.800}"
        },
        "border": {
          "$type": "color",
          "$value": "{color.blue.300}"
        }
      },
      "success": {
        "background": {
          "$type": "color",
          "$value": "{color.green.50}"
        },
        "foreground": {
          "$type": "color",
          "$value": "{color.green.800}"
        },
        "border": {
          "$type": "color",
          "$value": "{color.green.300}"
        }
      },
      "warning": {
        "background": {
          "$type": "color",
          "$value": "{color.amber.50}"
        },
        "foreground": {
          "$type": "color",
          "$value": "{color.amber.800}"
        },
        "border": {
          "$type": "color",
          "$value": "{color.amber.300}"
        }
      },
      "danger": {
        "background": {
          "$type": "color",
          "$value": "{color.red.50}"
        },
        "foreground": {
          "$type": "color",
          "$value": "{color.red.800}"
        },
        "border": {
          "$type": "color",
          "$value": "{color.red.300}"
        }
      }
    },
    "backdrop": {
      "scrim": {
        "$type": "color",
        "$value": "rgba(0, 0, 0, 0.48)"
      }
    }
  },
  "space": {
    "control": {
      "inline": {
        "$type": "dimension",
        "$value": "{space.400}"
      },
      "block": {
        "$type": "dimension",
        "$value": "{space.200}"
      }
    },
    "stack": {
      "sm": {
        "$type": "dimension",
        "$value": "{space.100}"
      },
      "md": {
        "$type": "dimension",
        "$value": "{space.200}"
      },
      "lg": {
        "$type": "dimension",
        "$value": "{space.400}"
      }
    },
    "surface": {
      "$type": "dimension",
      "$value": "{space.600}"
    }
  },
  "radius": {
    "control": {
      "$type": "dimension",
      "$value": "{radius.100}"
    },
    "surface": {
      "$type": "dimension",
      "$value": "{radius.200}"
    }
  },
  "shadow": {
    "raised": {
      "$type": "shadow",
      "$value": "{elevation.100}"
    },
    "overlay": {
      "$type": "shadow",
      "$value": "{elevation.200}"
    }
  },
  "zIndex": {
    "sticky": {
      "$type": "number",
      "$value": 10
    },
    "dropdown": {
      "$type": "number",
      "$value": 20
    },
    "modal": {
      "$type": "number",
      "$value": 40
    },
    "popover": {
      "$type": "number",
      "$value": 50
    },
    "toast": {
      "$type": "number",
      "$value": 100
    }
  }
}
