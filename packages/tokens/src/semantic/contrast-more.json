{
  "color": {
    "border": {
      "default": {
        "$type": "color",
        "$value": "{color.neutral.900}"
      },
      "focus": {
        "$type": "color",
        "$value": "{color.blue.700}"
      },
      "control": {
        "$type": "color",
        "$value": "{color.neutral.900}"
      },
      "strong": {
        "$type": "color",
        "$value": "{color.neutral.1000}"
      }
    },
    "foreground": {
      "muted": {
        "$type": "color",
        "$value": "{color.neutral.900}"
      }
    },
    "status": {
      "info": {
        "border": {
          "$type": "color",
          "$value": "{color.blue.800}"
        }
      },
      "success": {
        "border": {
          "$type": "color",
          "$value": "{color.green.800}"
        }
      },
      "warning": {
        "border": {
          "$type": "color",
          "$value": "{color.amber.800}"
        }
      },
      "danger": {
        "border": {
          "$type": "color",
          "$value": "{color.red.800}"
        }
      }
    }
  }
}
