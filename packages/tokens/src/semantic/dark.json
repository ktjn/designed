      "success": {
        "background": {
          "$type": "color",
          "$value": "{color.green.950}"
        },
        "foreground": {
          "$type": "color",
          "$value": "{color.green.200}"
        },
        "border": {
          "$type": "color",
          "$value": "{color.green.700}"
        }
      },
      "warning": {
        "background": {
          "$type": "color",
          "$value": "{color.amber.950}"
        },
        "foreground": {
          "$type": "color",
          "$value": "{color.amber.200}"
        },
        "border": {
          "$type": "color",
          "$value": "{color.amber.700}"
        }
      },
      "danger": {
        "background": {
          "$type": "color",
          "$value": "{color.red.950}"
        },
        "foreground": {
          "$type": "color",
          "$value": "{color.red.200}"
        },
        "border": {
          "$type": "color",
          "$value": "{color.red.700}"
        }
      }
