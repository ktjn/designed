{
  "color": {
    "border": {
      "default": {
        "$type": "color",
        "$value": "{color.neutral.200}"
      },
      "focus": {
        "$type": "color",
        "$value": "{color.blue.300}"
      },
      "control": {
        "$type": "color",
        "$value": "{color.neutral.100}"
      },
      "strong": {
        "$type": "color",
        "$value": "{color.neutral.0}"
      }
    },
    "foreground": {
      "muted": {
        "$type": "color",
        "$value": "{color.neutral.100}"
      }
    },
    "status": {
      "info": {
        "foreground": {
          "$type": "color",
          "$value": "{color.neutral.0}"
        },
        "border": {
          "$type": "color",
          "$value": "{color.blue.300}"
        }
      },
      "success": {
        "foreground": {
          "$type": "color",
          "$value": "{color.neutral.0}"
        },
        "border": {
          "$type": "color",
          "$value": "{color.green.300}"
        }
      },
      "warning": {
        "foreground": {
          "$type": "color",
          "$value": "{color.neutral.0}"
        },
        "border": {
          "$type": "color",
          "$value": "{color.amber.300}"
        }
      },
      "danger": {
        "foreground": {
          "$type": "color",
          "$value": "{color.neutral.0}"
        },
        "border": {
          "$type": "color",
          "$value": "{color.red.300}"
        }
      }
    }
  }
}
