{
  "name": "@ktjn/designed-tokens",
  "version": "0.6.1",
  "description": "Framework-independent design tokens for Designed.",
  "type": "module",
  "license": "MIT",
  "author": "ktjn",
  "homepage": "https://ktjn.github.io/designed/",
  "bugs": {
    "url": "https://github.com/ktjn/designed/issues"
  },
  "keywords": [
    "design-system",
    "design-tokens",
    "dtcg",
    "css-variables",
    "css-layers",
    "theming",
    "style-dictionary"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ktjn/designed.git",
    "directory": "packages/tokens"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./css/all.css": "./dist/css/all.css",
    "./css/base.css": "./dist/css/base.css",
    "./css/schemes/*.css": "./dist/css/schemes/*.css",
    "./css/brands/*.css": "./dist/css/brands/*.css",
    "./css/densities/*.css": "./dist/css/densities/*.css",
    "./css/contrasts/*.css": "./dist/css/contrasts/*.css",
    "./json/tokens.json": "./dist/json/tokens.json",
    "./types": {
      "types": "./dist/types/tokens.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsx scripts/build-tokens.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:package": "publint"
  },
  "devDependencies": {
    "@types/node": "26.6.7",
    "publint": "0.3.25",
    "style-dictionary": "5.8.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
