      "400": "#a1a1aa",
      "500": "#71717a",
      "700": "#3f3f46",
      "800": "#27272a",
      "900": "#18181b",
      "1000": "#000000"
    },
    "blue": {
      "50": "#eff6ff",
      "100": "#dbeafe",
      "200": "#bfdbfe",
      "300": "#93c5fd",
      "500": "#3b82f6",
      "600": "#2563eb",
      "700": "#1d4ed8",
      "800": "#1e40af",
      "950": "#172554"
    },
    "green": {
      "50": "#f0fdf4",
      "200": "#bbf7d0",
      "300": "#86efac",
      "600": "#16a34a",
      "700": "#15803d",
      "800": "#166534",
      "950": "#052e16"
    },
    "amber": {
      "50": "#fffbeb",
      "200": "#fde68a",
      "300": "#fcd34d",
      "600": "#d97706",
      "700": "#b45309",
      "800": "#92400e",
      "950": "#451a03"
    },
    "red": {
      "50": "#fef2f2",
      "200": "#fecaca",
      "300": "#fca5a5",
      "500": "#ef4444",
      "600": "#dc2626",
      "700": "#b91c1c",
      "800": "#991b1b",
      "950": "#450a0a"
    },
    "violet": {
      "100": "#ede9fe",
      "500": "#8b5cf6",
      "600": "#7c3aed",
      "700": "#6d28d9",
      "800": "#5b21b6",
      "950": "#2e1065"
    },
    "background": {
      "default": "#ffffff",
      "subtle": "#f4f4f5",
      "muted": "#e4e4e7",
      "selected": "#dbeafe"
    },
    "foreground": {
      "default": "#18181b",
      "muted": "#3f3f46",
      "inverse": "#ffffff"
    },
    "border": {
      "default": "#e4e4e7",
      "focus": "#3b82f6",
      "control": "#71717a",
      "strong": "#3f3f46"
    },
    "action": {
      "primary": {
        "default": "#2563eb",
        "hover": "#1d4ed8",
        "active": "#1e40af",
        "foreground": "#ffffff"
      },
      "danger": {
        "default": "#dc2626",
        "hover": "#b91c1c",
        "active": "#991b1b",
        "foreground": "#ffffff"
      }
    },
    "status": {
      "info": {
        "background": "#eff6ff",
        "foreground": "#1e40af",
        "border": "#93c5fd"
      },
      "success": {
        "background": "#f0fdf4",
        "foreground": "#166534",
        "border": "#86efac"
      },
      "warning": {
        "background": "#fffbeb",
        "foreground": "#92400e",
        "border": "#fcd34d"
      },
      "danger": {
        "background": "#fef2f2",
        "foreground": "#991b1b",
        "border": "#fca5a5"
      }
    }
  },
  "elevation": {
    "100": {
      "color": "#00000026",
      "offsetX": "0",
      "offsetY": "1px",
      "blur": "2px",
      "spread": "0"
    },
    "200": {
      "color": "#00000040",
      "offsetX": "0",
      "offsetY": "8px",
      "blur": "24px",
      "spread": "0"
    }
  },
  "font": {
    "family": {
      "base": ["system-ui", "sans-serif"]
    },
    "size": {
      "100": "0.875rem",
      "200": "1rem",
      "300": "1.25rem"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "bold": 700
    },
    "lineHeight": {
      "100": "1.25rem",
      "200": "1.5rem"
    }
  },
  "motion": {
    "duration": {
      "fast": "120ms",
      "default": "200ms"
    },
    "easing": {
      "standard": [0.2, 0, 0, 1]
    }
  },
  "radius": {
    "100": "0.25rem",
    "200": "0.5rem",
    "300": "0.75rem",
    "control": "0.25rem",
    "surface": "0.5rem"
  },
  "space": {
    "100": "0.25rem",
    "150": "0.375rem",
    "200": "0.5rem",
    "300": "0.75rem",
    "400": "1rem",
    "500": "1.25rem",
    "600": "1.5rem",
    "control": {
      "inline": "1rem",
      "block": "0.5rem"
    },
    "stack": {
      "sm": "0.25rem",
      "md": "0.5rem",
      "lg": "1rem"
    },
    "surface": "1.5rem"
  },
  "shadow": {
    "raised": {
      "color": "#00000026",
      "offsetX": "0",
      "offsetY": "1px",
      "blur": "2px",
      "spread": "0"
    },
    "overlay": {
      "color": "#00000040",
      "offsetX": "0",
      "offsetY": "8px",
      "blur": "24px",
      "spread": "0"
    }
  }
}
