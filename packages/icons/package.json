{
  "name": "@ktjn/design-icons",
  "version": "0.1.0",
  "description": "Typed React icon components generated from SVG source.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ktjn/design.git",
    "directory": "packages/icons"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "scripts": {
    "generate": "tsx scripts/build-icons.ts",
    "build": "pnpm run generate && tsup",
    "test": "pnpm run generate && vitest run",
    "typecheck": "pnpm run generate && tsc -p tsconfig.json --noEmit",
    "check:package": "publint && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@svgr/core": "8.1.0",
    "@svgr/plugin-jsx": "8.1.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "publint": "0.3.24",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "svgo": "4.1.0",
    "tsup": "8.5.0",
    "tsx": "4.19.4",
    "typescript": "6.0.2",
    "vitest": "5.0.0"
  }
}
