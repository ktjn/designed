{
  "name": "@ktjn/designed-icons",
  "version": "0.4.0",
  "description": "Typed React icon components generated from SVG source.",
  "type": "module",
  "license": "MIT",
  "author": "ktjn",
  "homepage": "https://ktjn.github.io/designed/",
  "bugs": {
    "url": "https://github.com/ktjn/designed/issues"
  },
  "keywords": [
    "design-system",
    "icons",
    "svg",
    "react",
    "typescript",
    "tree-shakeable"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ktjn/designed.git",
    "directory": "packages/icons"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "LICENSE-LUCIDE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "scripts": {
    "generate": "tsx scripts/build-icons.ts",
    "build": "pnpm run generate && tsup && tsc -p tsconfig.build.json",
    "test": "pnpm run generate && vitest run",
    "typecheck": "pnpm run generate && tsc -p tsconfig.json --noEmit",
    "check:package": "publint && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@svgr/core": "8.1.0",
    "@svgr/plugin-jsx": "8.1.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "svgo": "4.1.0",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
