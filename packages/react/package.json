{
  "name": "@ktjn/designed-react",
  "version": "0.6.0",
  "description": "React component library for Designed, built on Base UI.",
  "type": "module",
  "license": "MIT",
  "author": "ktjn",
  "homepage": "https://ktjn.github.io/designed/",
  "bugs": {
    "url": "https://github.com/ktjn/designed/issues"
  },
  "keywords": [
    "design-system",
    "react",
    "components",
    "ui",
    "base-ui",
    "accessible",
    "wcag",
    "css-modules",
    "css-layers",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ktjn/designed.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "peerDependencies": {
    "@ktjn/designed-tokens": "workspace:^",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@ktjn/designed-icons": "workspace:^"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@size-limit/esbuild": "14.3.0",
    "@size-limit/file": "14.3.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.1",
    "jsdom": "31.0.1",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "size-limit": "14.3.0",
    "tsup": "9.0.0",
    "typescript": "7.0.2",
    "vitest": "5.1.1",
    "vitest-axe": "1.0.0-pre.5"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:package": "publint && attw --pack . --profile esm-only",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "Button (single component import)",
      "path": "dist/button/button.js",
      "import": "{ Button }",
      "limit": "1.5 kB"
    },
    {
      "name": "Full package import (all components, including Base UI + floating-ui)",
      "path": "dist/index.js",
      "limit": "175 kB"
    }
  ]
}
